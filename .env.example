# Task 4: copy this file to .env, then paste your LangSmith API key below.
# .env is in .gitignore: never commit your key.
#
# The exporter adds /v1/traces to this base URL itself. Do not add it yourself.
# EU region: https://eu.api.smith.langchain.com/otel
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=lsv2_pt_PASTE_YOUR_KEY_HERE,Langsmith-Project=mai580-observability-lab

# Content capture (Task 3). NO_CONTENT is the safe default.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
